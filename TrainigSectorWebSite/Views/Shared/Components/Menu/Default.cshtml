@using System.Globalization
@using TrainigSectorDataEntry.ViewModel
@model List<MenuVm>

@{
    var culture = CultureInfo.CurrentCulture.Name; // ar | en-US | en
}
@foreach (var item in Model)
{
    var name = culture.StartsWith("ar") ? item.NameAr : item.NameEn;

    if (name != "عام" && name != "General")
    {
        <li>
            <a href="/Department/Index?EducationFacility=2&id=@item.Id">
                @name
            </a>
        </li>
    }
}