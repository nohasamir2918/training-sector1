@using System.Globalization
@using TrainigSectorDataEntry.ViewModel
@model List<MenuVm>

@{
    var culture = CultureInfo.CurrentCulture.Name; // ar | en-US | en
    var modeledit = Model.Where(a => a.DepatmentTypeID == 4).ToList();
}
@foreach (var item in modeledit)
{
    <li>
        <a href="/Labs/Index?EducationFacility=7&id=@item.Id">
            @(culture.StartsWith("ar")
                ? item.DepartmentNameAr
                : item.DepartmentNameEn)
        </a>
    </li>
}
