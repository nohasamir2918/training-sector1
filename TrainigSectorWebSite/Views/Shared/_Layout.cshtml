
@using Microsoft.AspNetCore.Localization
@using System.Globalization
@using TrainigSectorDataEntry.ViewModel



@inject IStringLocalizer<SharedResource> Localizer

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.TwoLetterISOLanguageName ?? "ar";
    var isArabic = currentCulture == "ar";
    var switchTo = isArabic ? "en" : "ar";
    var switchText = isArabic ? "English" : "العربية";
}
@{
    TrainigSectorWebSite.ViewModel.Breadcrumb breadcrumb = null;

    if (ViewData["Breadcrumb"] is TrainigSectorWebSite.ViewModel.Breadcrumb b)
    {
        breadcrumb = b;
    }
}



