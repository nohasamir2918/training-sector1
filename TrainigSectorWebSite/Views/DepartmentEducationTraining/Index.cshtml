@using TrainigSectorDataEntry.ViewModel
@model List<DepartmentsandbranchVM>
@using Microsoft.Extensions.Localization



@inject IStringLocalizer<TrainigSectorWebSite.SharedResource> SharedLocalizer

<style>
    .rtl {
        direction: rtl;
    }

    .ltr {
        direction: ltr;
    }
</style>

<div class="wrapper">

    @foreach (var group in Model.GroupBy(x => x.DepatmentTypeID))
    {


        <div class="parallax-counter-v2 parallaxBg1 margin-bottom-40">
            <div class="container">
                <div class="row">

                    <div class="col-md-9">

                        @foreach (var dept in group)
                        {
                            if (dept.DepartmentsandBranchesImages != null
                            && dept.DepartmentsandBranchesImages.Any())
                            {
                                <div class="carousel slide carousel-v1 margin-bottom-30" id="carousel-@dept.Id">
                                    <div class="carousel-inner">

                                        @for (int i = 0; i < dept.DepartmentsandBranchesImages.Count; i++)
                                        {
                                            var img = dept.DepartmentsandBranchesImages.ElementAt(i);
                                            var activeClass = i == 0 ? "active" : "";

                                            <div class="item @activeClass">
                                                <center>
                                                    <img class="img-responsive"
                                                         src="/DepartmentEducationTraining/GetImage?fileName=@img.ImagePath"
                                                         height="302"
                                                         width="600"
                                                         alt="" />
                                                </center>

                                                <div class="carousel-caption">
                                                    <h4 class="color-orange">
                                                        @(System.Threading.Thread.CurrentThread.CurrentCulture.Name.StartsWith("ar")
                                                            ? dept.NameAr
                                                            : dept.NameEn)
                                                    </h4>
                                                    <p>
                                                        @(System.Threading.Thread.CurrentThread.CurrentCulture.Name.StartsWith("ar")
																								? dept.DepartmentsandBranchesImages.ElementAt(i).DescriptionAr
                                                            : dept.DepartmentsandBranchesImages.ElementAt(i).DescriptionEn)
                                                    </p>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    @* الأسهم تظهر فقط لو في أكتر من صورة *@
                                    @if (dept.DepartmentsandBranchesImages.Count > 1)
                                    {
                                        <div class="carousel-arrow">
                                            <a data-slide="prev" href="#carousel-@dept.Id" class="left carousel-control">
                                                <i class="fa fa-angle-left"></i>
                                            </a>
                                            <a data-slide="next" href="#carousel-@dept.Id" class="right carousel-control">
                                                <i class="fa fa-angle-right"></i>
                                            </a>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>

                    <div class="col-md-3">
                                <h2 class="text-center color-orange f-w" style="text-align:@(System.Threading.Thread.CurrentThread.CurrentCulture.Name.StartsWith("ar") ? "right" : "left");
               direction:@(System.Threading.Thread.CurrentThread.CurrentCulture.Name.StartsWith("ar") ? "rtl" : "ltr");">
                            @(System.Threading.Thread.CurrentThread.CurrentCulture.Name.StartsWith("ar")
                                ? @group.FirstOrDefault().NameAr
                                : @group.FirstOrDefault().NameEn)
                        </h2>
                    </div>

                </div>
            </div>
        </div>
    }

</div>

