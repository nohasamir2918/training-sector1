@model TrainigSectorDataEntry.ViewModel.ComplaintsAndSuggestionVM
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<TrainigSectorWebSite.SharedResource> SharedLocalizer
<div class="container content height-500">
    <div class="profile">
        <div class="profile-body">
            <div class="profile-bio">
                <div id="sky-form3" class="sky-form">
                    <fieldset>

                        <!-- TITLE -->
                        <div class="row headline-center-v2 headline-center-v2-dark title margin-bottom-20">
                            <h2 class="color-orange">@SharedLocalizer["Title"]</h2>
                            <span class="bordered-icon"><i class="fa fa-th-large"></i></span>
                        </div>

                        <!-- SUCCESS MESSAGE -->
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success text-center">
                                @TempData["Success"]
                            </div>
                        }

                        <!-- MVC FORM -->
                        <form asp-action="Index"
                              asp-controller="Opinion"
                              method="post"
                              enctype="multipart/form-data"
                              >

                            @Html.AntiForgeryToken()

                            <div class="row">
                                <div class="col-md-2"></div>

                                <div class="col-md-8">
                                    <div class="panel panel-blue margin-bottom-40">
                                        <div class="panel-heading">
                                            <h3 class="panel-title">@SharedLocalizer["FormTitle"]</h3>
                                        </div>

                                        <div class="panel-body">

                                            <!-- NAME -->
                                            <div class="form-group">
                                                <label asp-for="Name"></label>
                                                <input asp-for="Name" class="form-control" />
                                                <span asp-validation-for="Name" class="text-danger"></span>
                                            </div>

                                            <!-- TELEPHONE -->
                                            <div class="form-group">
                                                <label asp-for="Telephone"></label>
                                                <input asp-for="Telephone" class="form-control" />
                                                <span asp-validation-for="Telephone" class="text-danger"></span>
                                            </div>

                                            <!-- EMAIL -->
                                            <div class="form-group">
                                                <label asp-for="Email"></label>
                                                <input asp-for="Email" class="form-control" />
                                                <span asp-validation-for="Email" class="text-danger"></span>
                                            </div>

                                            <!-- MESSAGE -->
                                            <div class="form-group">
                                                <label asp-for="ComplaintText"></label>
                                                <textarea asp-for="ComplaintText"
                                                          class="form-control"
                                                          rows="4"></textarea>
                                                <span asp-validation-for="ComplaintText" class="text-danger"></span>
                                            </div>

                                            <!-- FILE -->
                                            <div class="form-group">
                                                <label asp-for="UploadedFile"></label>
                                                <input asp-for="UploadedFile"
                                                       type="file"
                                                       class="form-control" />
                                                <span asp-validation-for="UploadedFile" class="text-danger"></span>
                                            </div>

                                            <br />

                                            <!-- SUBMIT -->
                                            <div class="form-group text-center">
                                                <button type="submit" class="btn-u btn-u-dark">
                                                    <i class="fa fa-envelope-o"></i> @SharedLocalizer["Send"]
                                                </button>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-2"></div>
                            </div>
                        </form>

                    </fieldset>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
