@model IEnumerable<TrainigSectorDataEntry.ViewModel.StagesAndHallVM>
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Microsoft.Extensions.Localization


@inject IStringLocalizer<SharedResource> Localizer
@{
    var culture = System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName;
}
@{
    var breadcrumb = (TrainigSectorWebSite.ViewModel.Breadcrumb)ViewData["Breadcrumb"];
}

<div class=" container content height-500">
    <div class="profile">
        <div class="profile-body">
            <div class="profile-bio">
                <div id="sky-form3" class="sky-form">
                    <fieldset>
                        <div class="row">

                            <div class="col-md-12">
                                <div class="headline-center-v2 headline-center-v2-dark title">
                                    <h2 class="color-orange">

                                        @ViewBag.title
                                    </h2>
                                    <span class="bordered-icon"><i class="fa fa-th-large"></i></span>
                                </div>
                            </div>
                        </div>


                      @{
    int count = 0;
}

@foreach (var project in Model)
{
    if (count % 3 == 0)
    {
        @:<div class="row mb-4">
    }

    <div class="col-md-4 col-sm-8">
        <section>
            <div class="high-rated techs">
                <div class="item">
                    <img class="img-responsive img-bordered"
                         alt=""
                         src="/RoomStage/GetImage?fileName=@project.HallsImages.FirstOrDefault()?.ImagePath">
                </div>
            </div>

            <div class="bg margin-bottom-25">
                @((culture == "ar") ? project.DescriptionAr : project.DescriptionEn)
            </div>
        </section>
    </div>

    count++;

    if (count % 3 == 0)
    {
        @:</div>
    }
}

@if (count % 3 != 0)
{
    @:</div>
}






                    </fieldset>
                </div>
            </div>
        </div>
    </div>
</div>