@model TrainigSectorDataEntry.ViewModel.ProjectVM
@using System.Globalization

@{
    var culture = CultureInfo.CurrentCulture.Name;
}

<link href="~/assets/ZoomImg/dist/remodal-default-theme.css" rel="stylesheet" />
<link href="~/assets/ZoomImg/dist/remodal.css" rel="stylesheet" />

<div class="container content">

    
        <div class="profile margin-bottom-40">
            <div class="profile-body">
                <div class="row">

                    <!-- ================== الصور ================== -->
                    <div class="col-md-4">

                        <div id="carousel-@Model.Id" class="carousel slide carousel-v1">
                            <div class="carousel-inner">

                                @if (Model.ProjectImages != null && Model.ProjectImages.Any())
                                {
                                    int i = 0;
                                    foreach (var img in Model.ProjectImages)
                                    {
                                        <div class="item @(i == 0 ? "active" : "")">
                                            <img class="img-responsive"
                                                 style="height:302px;width:100%;cursor:pointer"
                                                 src="@Url.Action("GetImage", "ProjectDetails", new { fileName = img.ImagePath })"
                                                 onclick="openModal('@Url.Action("GetImage", "ProjectDetails", new { fileName = img.ImagePath })')" />
                                        </div>
                                        i++;
                                    }
                                }
                                else
                                {
                                    <div class="item active">
                                        <img class="img-responsive"
                                             style="height:302px;width:100%"
                                             src="~/assets/img/no-image.png" />
                                    </div>
                                }

                            </div>

                            <a class="left carousel-control"
                               href="#carousel-@Model.Id"
                               data-slide="prev">
                                <i class="fa fa-angle-left"></i>
                            </a>

                            <a class="right carousel-control"
                               href="#carousel-@Model.Id"
                               data-slide="next">
                                <i class="fa fa-angle-right"></i>
                            </a>
                        </div>

                    </div>

                    <!-- ================== التفاصيل ================== -->
                    <div class="col-md-8">

                        <div class="headline">
                        <h3 style="text-align:@(culture.StartsWith("ar") ? "right" : "left");
               direction:@(culture.StartsWith("ar") ? "rtl" : "ltr");">
                                @(culture.StartsWith("ar")
                                    ? Model.TitleAr
                                    : Model.TitleEn)
                            </h3>
                        </div>

                        <div class="margin-bottom-20">
                            @(culture.StartsWith("ar")
                                ? Model.DescriptionAr
                                : Model.DescriptionEn)
                        </div>

                    </div>

                </div>
            </div>
        </div>
    


   

</div>


<!-- ================== Modal لعرض الصورة ================== -->
<div id="imageModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-body text-center">
                <img id="modalImage" class="img-responsive" style="width:100%" />
            </div>
        </div>
    </div>
</div>


<script src="~/ArAJax/jquery.min.js"></script>
<script src="~/assets/ZoomImg/dist/remodal.js"></script>

<script>
    function openModal(imageUrl) {
        $("#modalImage").attr("src", imageUrl);
        $("#imageModal").modal("show");
    }
</script>
