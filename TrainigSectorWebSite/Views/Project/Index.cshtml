@model IEnumerable<TrainigSectorDataEntry.ViewModel.ProjectVM>
@using Microsoft.Extensions.Localization


@inject IStringLocalizer<TrainigSectorWebSite.SharedResource> SharedLocalizer

@{
    var culture = System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName;
}
<div class="container-fluid margin-bottom-25">

    <div class="row">
        <div class="col-md-12">
            <div class="bg">
                <div class="history-p">

                    <div class="wrapper">

                        <!--=== News Block ===-->
                        <div class="container">
                            <div class="text-center margin-bottom-50">


                                <div class="headline-center-v2 headline-center-v2-dark title">
                                    <h2 class="color-orange">@SharedLocalizer["Projects"]</h2>
                                    <span class="bordered-icon"><i class="fa fa-th-large"></i></span>
                                </div>

                            </div>

                            <div class="row news-v2">

                                @foreach (var project in Model)
                                {
                                       <div class="col-md-4 sm-margin-bottom-30">
                                        <div class="news-v2-badge">
                                            <img class="img-responsive" src="/News/GetImage?fileName=@project.ProjectImages.FirstOrDefault()?.ImagePath" />
                                            <p>
                                                <span>@project.UserCreationDate?.Day</span>
                                                <small>@project.UserCreationDate?.ToString("MMMM", new System.Globalization.CultureInfo(culture))</small>
                                            </p>
                                        </div>

                                        <div class="news-v2-desc bg-color-light rtl">
                                            <h3>
                                                <a href="/ProjectDetails/Index/@project.Id" class="new-color">@((culture == "ar") ? project.TitleAr : project.TitleEn)</a>
                                            </h3>
                                            <p>@((culture == "ar") ? project.DescriptionAr : project.DescriptionEn)</p>
                                        </div>
                                        
                                    </div>
                                }
                              
           
        </div>
    </div>
    <!--=== End News Block ===-->

</div><!--/wrapper-->
</div>
 </div>
 </div>

 </div>
</div>
