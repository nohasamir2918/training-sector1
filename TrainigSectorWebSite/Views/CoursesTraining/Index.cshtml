@using Microsoft.Extensions.Localization
@using TrainigSectorDataEntry.ViewModel
@model List<TrainingCoursesTypeVM>
@inject IStringLocalizer<TrainigSectorWebSite.SharedResource> SharedLocalizer




<div class="container content height-500"> 
    <div class="profile">
        <div class="profile-body">
            <div class="profile-bio">
                <div id="sky-form3" class="sky-form"> 
                    <div class="row"> 
                        <div class="headline-center-v2 headline-center-v2-dark title"> 
                            <h2 class="color-orange">@SharedLocalizer["TainingCourses"]</h2> 
                            <span class="bordered-icon"><i class="fa fa-th-large"></i></span>
                        </div> 
                        </div> 
                        <div class="row">
                            <section class="col col-2"></section> 
                            <section class="col col-8 "> 
                                <label class="input col col-9">
                                <select class="form-control" id="courseTypeSelect">
                                    <option value="0">-- اختر --</option>
                                    @foreach (var item in Model)
                                    {
                                        <option value="@item.Id">@item.NameAr</option>
                                    }
                                        </select> <i class="icon-append fa fa-chevron-circle-down"></i> </label> 
                                        <div class="label resault col col-3">اسم الدورة</div> 
                                    </section> 
                                    <section class="col col-2"></section> 
                                </div>

                    <div class="row">
                        <section class="col col-2"></section>
                        <section class="col col-8" id="coursesSection" style="display:none">

                            <div class="panel panel-grey margin-bottom-40">
                                <div class="panel-heading">
                                    <h3 class="panel-title">
                                        <i class="fa fa-globe"></i> اسم الدورة
                                    </h3>
                                </div>

                                <div class="panel-body">
                                    <table class="table table-bordered">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>اسم الدورة</th>
                                                <th>تحميل</th>
                                            </tr>
                                        </thead>
                                        <tbody id="coursesTableBody">
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </section>
                        <section class="col col-2"></section>
                    </div>








                                </div> 
                                </div>
                                </div> 
                                </div>
                                </div>




<script>
    $('#courseTypeSelect').change(function () {

        var typeId = $(this).val();

        if (!typeId) {
            $('#coursesSection').hide();
            $('#coursesTableBody').empty();
            return;
        }

        $.ajax({
            url: '/CoursesTraining/GetCoursesByType',
            type: 'GET',
            data: { typeId: typeId },
            success: function (data) {

                $('#coursesTableBody').empty();

                if (data.length === 0) {
                    $('#coursesTableBody').append(
                        '<tr><td colspan="3" class="text-center">لا توجد دورات</td></tr>'
                    );
                } else {
                    $.each(data, function (i, item) {
                        $('#coursesTableBody').append(`
                            <tr>
                                <td class="td-color">${item.index}</td>
                                <td class="f-w">${item.name}</td>
                                <td>
                                    <a href="/CoursesTraining/GetImage?fileName=${item.filePath}"
                                       class="btn-u btn-u-xs btn-u-dark"
                                       target="_blank">
                                        <i class="fa fa-download"></i>
                                        تحميل التفاصيل
                                    </a>

                                   

                                </td>
                            </tr>
                        `);
                    });
                }

                $('#coursesSection').show();
            }
        });
    });
</script>

