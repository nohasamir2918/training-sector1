@model IEnumerable<TrainigSectorDataEntry.ViewModel.DepartmentsandBranchesDetailVM>
@using System.Globalization
@using TrainigSectorDataEntry.ViewModel

@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var firstDept = Model?.FirstOrDefault();
}

@if (firstDept != null)
{
    <div class="headline-center-v2 headline-center-v2-dark title margin-bottom-25">
        <h2 class="color-orange">
            @(culture == "ar" ? firstDept.NameAr : firstDept.NameEn)
        </h2>
        <span class="bordered-icon"><i class="fa fa-th-large"></i></span>
    </div>
}

<div class="wrapper">

    @foreach (var dept in Model ?? Enumerable.Empty<DepartmentsandBranchesDetailVM>())
    {
        foreach (var spec in dept.Specializations ?? Enumerable.Empty<SpecializationVM>())
        {
            var images = spec.SpecializationImages;
            var imageCount = images != null ? images.Count : 0;

            if (imageCount > 0)
            {
                var carouselId = $"carousel-{spec.Id}";

                <div class="margin-bottom-40">
                    <div class="container">
                        <div class="row">

                            <!-- CAROUSEL -->
                            <div class="col-md-9">
                                <div class="carousel slide carousel-v1" id="@carouselId" data-ride="carousel">
                                    <div class="carousel-inner">

                                        @{
                                            var isFirst = true;
                                        }

                                        @foreach (var img in images)
                                        {
                                            <div class="item @(isFirst ? "active" : "")">
                                                <center>
                                                    <img class="img-responsive"
                                                         src="/Department/GetImage?fileName=@img.ImagePath"
                                                         height="302"
                                                         width="600"
                                                         alt="@(culture == "ar" ? spec.NameAr : spec.NameEn)" />
                                                </center>

                                                <div class="carousel-caption">
                                                    <h4 class="color-orange">
                                                        @(culture == "ar" ? spec.NameAr : spec.NameEn)
                                                    </h4>
                                                    <p>
                                                        @(System.Threading.Thread.CurrentThread.CurrentCulture.Name.StartsWith("ar")
                                                            ? img.DescriptionAr
                                                            : img.DescriptionEn)
                                                    </p>
                                                </div>
                                            </div>

                                            isFirst = false;
                                        }

                                    </div>

                                    @* الأسهم تظهر فقط لو في أكتر من صورة *@
                                    @if (imageCount > 1)
                                    {
                                        <div class="carousel-arrow">
                                            <a class="left carousel-control" href="#@carouselId" data-slide="prev">
                                                <i class="fa fa-angle-left"></i>
                                            </a>
                                            <a class="right carousel-control" href="#@carouselId" data-slide="next">
                                                <i class="fa fa-angle-right"></i>
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- SPECIALIZATION NAME -->
                            <div class="col-md-3">
                                <h2 class="text-center f-w">
                                    @(culture == "ar" ? spec.NameAr : spec.NameEn)
                                </h2>
                               
                            </div>

                        </div>
                    </div>
                </div>
            }
        }
    }

</div>
