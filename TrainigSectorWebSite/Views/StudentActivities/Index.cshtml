@model IEnumerable<TrainigSectorDataEntry.ViewModel.StudentActiviteVM>
@using Microsoft.Extensions.Localization


@inject IStringLocalizer<SharedResource> Localizer


@{
    var culture = System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName;
}

<div class=" container content height-500">
    <div class="profile">
        <div class="profile-body">
            <div class="profile-bio">
                <div id="sky-form3" class="sky-form">
                    <fieldset>
                        <div class="row">

                            <div class="col-md-12">
                                <div class="headline-center-v2 headline-center-v2-dark title">
                                    <h2 class="color-orange">
                                        @Localizer["StudentActivities"]
                                    </h2>
                                    <span class="bordered-icon"><i class="fa fa-th-large"></i></span>
                                </div>
                            </div>
                        </div>


                      @{
    int count = 0;
}

@foreach (var activity in Model)
{
    if (count % 3 == 0)
    {
        var dir = (culture == "ar") ? "rtl" : "ltr";
     @:<div class="row mb-4" style="direction:@dir;">
    }

    <div class="col-md-4 col-sm-6">
        <section>
            <div class="high-rated techs">
                <div class="item">
                    <img class="img-responsive img-bordered"
                         alt=""
                         src="/StudentActivities/GetImage?fileName=@activity.ImagePath">
                </div>
            </div>

       <div class="bg margin-bottom-25" style="text-align:@(culture == "ar" ? "right" : "left")">
    @((culture == "ar") ? activity.DescriptionAr : activity.DescriptionEn)
</div>
        </section>
    </div>

    count++;

    if (count % 3 == 0)
    {
        @:</div>
    }
}

@if (count % 3 != 0)
{
    @:</div>
}







                    </fieldset>
                </div>
            </div>
        </div>
    </div>
</div>