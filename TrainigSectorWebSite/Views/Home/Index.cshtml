@using TrainigSectorDataEntry.Models
@model List<Slider>

@{
    bool isArabic = System.Threading.Thread.CurrentThread.CurrentCulture
                        .TwoLetterISOLanguageName == "ar";
}
@{
    ViewData["Title"] = "Home Page";
}

    <style >
    .breadcrumbs {
        display: none;
    }

    #map {
        height: 250px;
        font-family: 'DroidArabicKufi' !important;
    }
</style>


<!--=== Slider ===-->
<div class="slider-inner">
    <div id="da-slider" class="da-slider">

        @for (int i = 0; i < Model.Count; i++)
        {
            var title = isArabic ? Model[i].TitleAr : Model[i].TitleEn;
            var desc = isArabic ? Model[i].DescriptionAr : Model[i].DescriptionEn;

            <div class="da-slide @(i == 0 ? "da-slide-current" : "")">

                <h2>
                    <br />
                    <i>@title</i>
                </h2>

                @if (!string.IsNullOrWhiteSpace(desc))
                {
                    <p class="p-slider">
                        <i>@Html.Raw(desc.Replace("\n", "<br />"))</i>
                    </p>
                }

                <div class="da-img">
                    @if (Model[i].IsVideo.Value)
                    {
                        <iframe src="@Model[i].FilePath"
                                width="530"
                                height="300"
                                frameborder="0"
                                allowfullscreen>
                        </iframe>
                    }
                    else
                    {
                        <img src="@Url.Content(Model[i].FilePath)"
                             class="img-responsive vision-img"
                             style="height:300px;" />
                    }
                </div>

            </div>
        }

        <div class="da-arrows">
            <span class="da-arrows-next"></span>
            <span class="da-arrows-prev"></span>
        </div>

    </div>
</div><!--=== End Slider ===-->
<!--/Start wrapper-->
<div class="wrapper">

    <!--=== Content Part ===-->
    <div class="container-fluid margin-bottom-25">

        <!-- Recent Works -->
        <div class="row margin-bottom-20 margin-top-60">



            <div class="col-md-4 col-sm-6">
                <div class="thumbnails thumbnail-style thumbnail-kenburn">
                    <div class="thumbnail-img">
                        <div class="overflow-hidden">
                            <a href="/news/Index">
                                <img class="img-responsive img-bordered" src="~/assets/img/training/adver.jpeg" />
                            </a>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-md-4 col-sm-6">
                <div class="thumbnails thumbnail-style thumbnail-kenburn">
                    <div class="thumbnail-img">
                        <div class="overflow-hidden">
                            <a href="/Quality/Index">
                                <img class="img-responsive img-bordered" src="~/assets/img/training/good.jpeg" />
                            </a>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-md-4 col-sm-6">
                <div class="thumbnails thumbnail-style thumbnail-kenburn">
                    <div class="thumbnail-img">
                        <div class="overflow-hidden">
                            <a href="/StudentServiceInstitute/Index">
                               <img class="img-responsive img-bordered" src="~/assets/img/training/ser.jpeg" />
                            </a>
                        </div>
                    </div>
                </div>
            </div>


            
        </div>
        <div class="row margin-bottom-20 ">



            <div class="col-md-4 col-sm-6">
                <div class="thumbnails thumbnail-style thumbnail-kenburn">
                    <div class="thumbnail-img">
                        <div class="overflow-hidden">
                            <a href="/CoursesTraining/Index">
                                <img class="img-responsive img-bordered" src="~/assets/img/training/train.jpeg" />
                            </a>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-md-4 col-sm-6">
                <div class="thumbnails thumbnail-style thumbnail-kenburn">
                    <div class="thumbnail-img">
                        <div class="overflow-hidden">
                            <a href="/Opinion/Index">
                                <img class="img-responsive img-bordered" src="~/assets/img/training/offer.jpeg" />
                            </a>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-md-4 col-sm-6">
                <div class="thumbnails thumbnail-style thumbnail-kenburn">
                    <div class="thumbnail-img">
                        <div class="overflow-hidden">
                            <a href="/VideoStory/Index">
                                <img class="img-responsive img-bordered" src="~/assets/img/training/suc.jpeg" />
                            </a>
                        </div>
                    </div>
                </div>
            </div>


         
        </div>
        <!-- End Recent Works -->

    </div><!--/container-->
    <!-- End Content Part -->

    <div>
     

        <div id="map" height="250" width="100%"></div>

        <script>

            // This example displays a marker at the center of Australia.
            // When the user clicks the marker, an info window opens.

            function initMap() {

                var uluru = { lat: 30.177360, lng: 31.431396 };
                var map = new google.maps.Map(document.getElementById('map'), {
                    zoom: 10,
                    center: uluru
                });

                var contentString = '<div id="content">' +
                '<div id="siteNotice"><b>' +
                '</div>&nbsp;&nbsp;' +
                'قطاع التدريب' +
                '<div id="bodyContent">' +
                'وزارة الإنتاج الحربي ' +
                '</div>' +
                '</b></div>';

                var infowindow = new google.maps.InfoWindow({
                    content: contentString
                });

                var marker = new google.maps.Marker({
                    position: uluru,
                    map: map,
                    title: 'قطاع التدريب'
                });

                infowindow.open(map, marker);
                marker.addListener('click', function () {
                    infowindow.open(map, marker);
                });
            }
        </script>
        <script async defer src="https://maps.googleapis.com/maps/api/js?key=AIzaSyC13syEbyihukkyThDVxZpkBmuG-9czQNY&#10&callback=initMap">
        </script>



      

    </div>


</div>
<!--/End wrapper-->
