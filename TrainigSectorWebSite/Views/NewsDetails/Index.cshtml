@model TrainigSectorDataEntry.ViewModel.NewsVM
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Microsoft.Extensions.Localization


@inject IStringLocalizer<SharedResource> Localizer
@{
    var culture = System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName;
}

<link href="~/assets/ZoomImg/dist/remodal-default-theme.css" rel="stylesheet" type="text/css" />
<link href="~/assets/ZoomImg/dist/remodal.css" rel="stylesheet" type="text/css" />

<div class="container content height-500">
    <div class="profile">
        <div class="profile-body">
            <div class="profile-bio">
                <div id="sky-form3" class="sky-form">
                    <fieldset>
                        <div class="row">
                            <div class="col-sm-4 shadow-wrapper md-margin-bottom-40">
                                <section>
                                    <div class="high-rated techs">
                                        <div id="carousel-example-generic" class="carousel slide" data-ride="carousel">
                                            @{
                                                var images = Model.NewsImages.ToList();
                                            }

                                            <ol class="carousel-indicators ">
                                                @for (int i = 0; i < images.Count; i++)
                                                {
                                                    <li class="rounded-x @(i == images.Count - 1 ? "active" : "")"
                                                        data-target="#carousel-example-generic"
                                                        data-slide-to="@i">
                                                    </li>
                                                }
                                            </ol>

                                            <div class="carousel-inner">
                                                @for (int i = 0; i < images.Count; i++)
                                                {
                                                    <div class="item @(i == images.Count - 1 ? "active" : "")">
                                                        <img class="img-responsive img-bordered"
                                                             src="/NewsDetails/GetImage?fileName=@images[i].ImagePath"
                                                             alt="">
                                                    </div>
                                                }
                                            </div>

                                                                            </div>
                                                                            </div>
                                                                            </section>
                                <!-- Zoom icon -->
                                <span id="zoomIcon" style="cursor:pointer;">
                                    <i class="fa fa-plus"></i>
                                </span>
                    
                            </div>
                    
                            <div class="col-md-8">
                                <div class="about-me headline news-tilte ">
                                    <h3>
                                        <span>
                                            @((culture == "ar") ? Model.TitleAr : Model.TitleEn)
                                        </span>

                                    </h3>
                                </div>
                                <div class="bg  margin-bottom-15">
                                    <span id="ContentPlaceHolder1_LabDes">
                                        
                                        @((culture == "ar") ? Model.ShortDescriptionAr : Model.ShortDescriptionEn)
                                      
                                    </span>
                                </div>
                            </div>





                        </div>
                    </fieldset>
                </div>
            </div>
        </div>
    </div>
</div>




<!-- Modal for gallery -->
<div class="modal fade" id="galleryModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-body text-center">
                <!-- Bootstrap carousel inside modal -->
                <div id="modalCarousel" class="carousel slide" data-ride="carousel">

                    <!-- Indicators -->
                    <ol class="carousel-indicators">
                        @for (int i = 0; i < images.Count; i++)
                        {
                            <li data-target="#modalCarousel"
                                data-slide-to="@i"
                                class="@(i == images.Count - 1 ? "active" : "")">
                            </li>
                        }
                    </ol>

                    <div class="carousel-inner">
                        @for (int i = 0; i < images.Count; i++)
                        {
                            <div class="item @(i == images.Count - 1 ? "active" : "")">
                                <img src="/NewsDetails/GetImage?fileName=@images[i].ImagePath"
                                     class="img-responsive"
                                     alt="">
                            </div>
                        }
                    </div>


                    <!-- Controls -->
                    <a class="left carousel-control" href="#modalCarousel" role="button" data-slide="prev">
                        <span class="fa fa-chevron-left" aria-hidden="true"></span>
                        <span class="sr-only">Previous</span>
                    </a>
                    <a class="right carousel-control" href="#modalCarousel" role="button" data-slide="next">
                        <span class="fa fa-chevron-right" aria-hidden="true"></span>
                        <span class="sr-only">Next</span>
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/ArAJax/jquery.min.js" type="text/javascript"></script>


<script>    window.jQuery || document.write('<script src="~/ArAJax/jquery.min.js"><\/script>')</script>
<script src="~/assets/ZoomImg/dist/remodal.js"></script>
<script>
    $(document).on('opening', '.remodal', function () {
        console.log('opening');
    });

    $(document).on('opened', '.remodal', function () {
        console.log('opened');
    });

    $(document).on('closing', '.remodal', function (e) {
        console.log('closing' + (e.reason ? ', reason: ' + e.reason : ''));
    });

    $(document).on('closed', '.remodal', function (e) {
        console.log('closed' + (e.reason ? ', reason: ' + e.reason : ''));
    });

    $(document).on('confirmation', '.remodal', function () {
        console.log('confirmation');
    });

    $(document).on('cancellation', '.remodal', function () {
        console.log('cancellation');
    });


</script>
<script>
    // Open modal when zoom icon is clicked
    document.getElementById('zoomIcon').addEventListener('click', function() {
      $('#galleryModal').modal('show');
    });
</script>


