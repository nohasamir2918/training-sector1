@model IEnumerable<TrainigSectorDataEntry.ViewModel.HistoryBreifVM>
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    var culture = System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName;
}

<div class="container content">
    <div class="profile">
        <div class="profile-body">
            <div class="profile-bio">
                <div id="sky-form3" class="sky-form">
                    <fieldset>

                        @foreach (var item in Model)
                        {
                            var title = culture == "ar" ? item.TitleAr : item.TitleEn;
                            var description = culture == "ar" ? item.DescriptionAr : item.DescriptionEn;
                            string carouselId = $"carousel-{item.Id}";

                            <div class="row mb-4" style="direction:@(culture == "ar" ? "rtl" : "ltr")">

                                <!-- ================== Carousel ================== -->
                                <div class="col-md-4">
                                    <section>
                                        <div id="@carouselId" class="carousel slide" data-ride="carousel">

                                            <div class="carousel-inner">
                                                @for (int i = 0; i < item.HistoryBerifImages.Count; i++)
                                                {
                                                    var img = item.HistoryBerifImages.ElementAt(i);

                                                    <div class="item @(i == 0 ? "active" : "")">
                                                        <img class="img-responsive img-bordered"
                                                             src="/TrainingHistory/GetImage?fileName=@img.ImagePath"
                                                             alt="@title" />
                                                    </div>
                                                }
                                            </div>

                                            <a class="left carousel-control" href="#@carouselId" data-slide="prev">
                                                <i class="fa fa-angle-left"></i>
                                            </a>
                                            <a class="right carousel-control" href="#@carouselId" data-slide="next">
                                                <i class="fa fa-angle-right"></i>
                                            </a>

                                        </div>
                                    </section>

                                    <!-- 🔍 عدسة واحدة فقط -->
                                    <div class="text-center mt-2">
                                        <i class="fa fa-search-plus fa-2x"
                                           style="color:#f60; cursor:pointer;"
                                           onclick="openGallery('@carouselId')">
                                        </i>
                                    </div>

                                </div>

                                <!-- ================== Text ================== -->
                                <div class="col-md-8">
                                    <div class="headline-center-v2 headline-center-v2-dark title">
                                        <h2 class="color-orange">@title</h2>
                                        <span class="bordered-icon">
                                            <i class="fa fa-th-large"></i>
                                        </span>
                                    </div>

                                    <p class="bg margin-bottom-25"
                                       style="text-align:@(culture == "ar" ? "right" : "left")">
                                        @description
                                    </p>
                                </div>

                            </div>
                        }

                    </fieldset>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================== Zoom Modal ================== -->
<div id="galleryModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-body">

                <div id="modalCarousel" class="carousel slide" data-ride="carousel">

                    <div class="carousel-inner" id="modalCarouselInner">
                        <!-- Images injected dynamically -->
                    </div>

                    <!-- Controls -->
                    <a class="left carousel-control" href="#modalCarousel" data-slide="prev">
                        <i class="fa fa-angle-left fa-2x"></i>
                    </a>
                    <a class="right carousel-control" href="#modalCarousel" data-slide="next">
                        <i class="fa fa-angle-right fa-2x"></i>
                    </a>

                </div>

            </div>
        </div>
    </div>
</div>

<!-- ================== Scripts ================== -->
<script src="~/assets/plugins/jquery/jquery.min.js"></script>
<script src="~/assets/plugins/bootstrap/js/bootstrap.min.js"></script>

<script>
    function openGallery(carouselId) {

        var images = $("#" + carouselId + " .carousel-inner img");
        var modalInner = $("#modalCarouselInner");

        modalInner.html("");

        images.each(function (index) {

            var src = $(this).attr("src");
            var itemClass = index === 0 ? "item active" : "item";

            modalInner.append(
                '<div class="' + itemClass + '">' +
                '<img src="' + src + '" class="img-responsive" style="width:100%">' +
                '</div>'
            );
        });

        $("#galleryModal").modal("show");
    }
</script>
